 "html": "<div style=\"\n\tbackground: #0d0d0d;\n\tcolor: #f5f5f5;\n\tfont-family: 'Courier New', monospace;\n\tmax-width: 600px;\n\tmargin: 0 auto;\n\tborder: 2px dashed #d4af37;\n\tborder-radius: 8px;\n\tpadding: 24px;\n\">\n\t<div style=\"text-align:center; border-bottom: 1px dashed #d4af37; padding-bottom:16px; margin-bottom:16px;\">\n\t\t<h1 style=\"color:#d4af37; margin:0; letter-spacing:2px;\">\ud83c\udfac MOVIE TICKETS</h1>\n\t\t<p style=\"color:#999; font-size:11px; margin:4px 0 0;\">ADMIT ONE</p>\n\t</div>\n\n\t<div style=\"display:flex; gap:16px;\">\n\t\t{% set poster = doc.get_movie_poster() %}\n\t\t{% if poster %}\n\t\t<div style=\"flex-shrink:0;\">\n\t\t\t<img src=\"{{ poster }}\" style=\"width:100px; height:150px; object-fit:cover; border-radius:4px; border:1px solid #d4af37;\">\n\t\t</div>\n\t\t{% endif %}\n\n\t\t<div style=\"flex-grow:1;\">\n\t\t\t<h2 style=\"color:#fff; margin:0 0 8px; font-size:20px;\">{{ doc.movie_title }}</h2>\n\n\t\t\t<table style=\"width:100%; font-size:13px; color:#ccc;\">\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:3px 0; color:#999;\">Theater</td>\n\t\t\t\t\t<td style=\"padding:3px 0; text-align:right;\">{{ doc.theater }}</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:3px 0; color:#999;\">Screen</td>\n\t\t\t\t\t<td style=\"padding:3px 0; text-align:right;\">{{ doc.screen }}</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:3px 0; color:#999;\">Date &amp; Time</td>\n\t\t\t\t\t<td style=\"padding:3px 0; text-align:right;\">{{ doc.show_date }} at {{ doc.start_time }}</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:3px 0; color:#999;\">Seats</td>\n\t\t\t\t\t<td style=\"padding:3px 0; text-align:right;\">\n\t\t\t\t\t\t{% for seat in doc.seats %}{{ seat.seat_label }}{% if not loop.last %}, {% endif %}{% endfor %}\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t</table>\n\t\t</div>\n\t</div>\n\n\t<div style=\"\n\t\tdisplay:flex;\n\t\tjustify-content:space-between;\n\t\talign-items:center;\n\t\tborder-top: 1px dashed #d4af37;\n\t\tmargin-top:16px;\n\t\tpadding-top:16px;\n\t\">\n\t\t<div>\n\t\t\t<p style=\"color:#999; font-size:11px; margin:0;\">BOOKING ID</p>\n\t\t\t<p style=\"color:#d4af37; font-size:16px; font-weight:bold; margin:2px 0 0; letter-spacing:1px;\">{{ doc.name }}</p>\n\t\t\t<p style=\"color:#999; font-size:11px; margin:8px 0 0;\">TOTAL AMOUNT</p>\n\t\t\t<p style=\"color:#fff; font-size:16px; font-weight:bold; margin:2px 0 0;\">&#8377;{{ doc.total_amount }}</p>\n\t\t</div>\n\n\t\t{% set qr_url = doc.get_or_create_qr_code() %}\n\t\t{% if qr_url %}\n\t\t<div style=\"text-align:center;\">\n\t\t\t<img src=\"{{ qr_url }}\" style=\"width:100px; height:100px; background:#fff; padding:4px; border-radius:4px;\">\n\t\t\t<p style=\"color:#666; font-size:9px; margin:4px 0 0;\">SCAN AT COUNTER</p>\n\t\t</div>\n\t\t{% endif %}\n\t</div>\n\n\t<p style=\"text-align:center; color:#666; font-size:10px; margin-top:16px; letter-spacing:1px;\">\n\t\t\u2605 ENJOY THE SHOW \u2605\n\t</p>\n</div>",
